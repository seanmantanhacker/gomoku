<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <title>Make It 16 - Gomoku Number Strategy</title>
  <link rel="stylesheet" href="/style.css">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <audio id="clickSound" src="/mixkit-sick-man-sneeze-2213.wav" preload="auto"></audio>

  <!-- Navigation & Header Bar -->
  <header class="app-header">
    <div class="brand">
      <div class="brand-icon">16</div>
      <div class="brand-title">MAKE IT 16</div>
      <span class="brand-badge">Gomoku</span>
    </div>

    <div class="header-status" id="matchStatusPill">
      <span class="status-dot" id="statusDot"></span>
      <span id="matchStatusText">Waiting for Players...</span>
    </div>

    <div class="header-actions">
      <div class="spectator-badge" id="spectatorBadge" title="Current spectators in the room">
        👁️ <span id="spectatorCount">0</span>
      </div>
      <button class="btn-icon-text" id="btnRules" title="How to play">
        ℹ️ <span>Rules</span>
      </button>
      <button class="btn-icon-text" id="btnMute" title="Toggle sound">
        🔊 <span>Sound</span>
      </button>
      <button class="btn-icon-text" id="btnRestart" title="Restart room">
        🔄 <span>Reset</span>
      </button>
    </div>
  </header>

  <!-- Main Match Arena -->
  <main class="match-arena">
    <!-- Players VS Bar -->
    <div class="players-bar">
      <!-- Player 1 Card (White) -->
      <div class="player-card" id="cardPlayer1">
        <div class="player-avatar white-stone">⚪</div>
        <div class="player-meta">
          <div class="player-title">Player 1 (White)</div>
          <div class="player-status-tag" id="statusPlayer1">Vacant</div>
        </div>
        <button class="btn-join" id="btnJoinPlayer1">Join</button>
      </div>

      <div class="vs-badge">VS</div>

      <!-- Player 2 Card (Black) -->
      <div class="player-card" id="cardPlayer2">
        <div class="player-avatar black-stone">⚫</div>
        <div class="player-meta">
          <div class="player-title">Player 2 (Black)</div>
          <div class="player-status-tag" id="statusPlayer2">Vacant</div>
        </div>
        <button class="btn-join" id="btnJoinPlayer2">Join</button>
      </div>
    </div>

    <!-- Viewer Role Banner -->
    <div class="role-banner" id="roleBanner">
      Connecting to room...
    </div>

    <!-- The 15x15 Gomoku Board -->
    <div class="board-wrapper">
      <div class="board" id="board"></div>
    </div>

    <!-- Bottom Player Inventory / Action Tray -->
    <div class="action-tray none" id="actionTray">
      <div class="tray-header">
        <span class="tray-title" id="trayOwnerText">Your Stones</span>
        <span id="trayHintText">Click a cell on the board, then select a stone:</span>
      </div>
      <div class="stone-selector-grid">
        <!-- Stone 1 -->
        <div class="stone-card" data-stone="1" id="stoneCard1">
          <div class="stone-preview white" id="previewStone1">1</div>
          <span class="stock-count" id="countStone1">x5</span>
          <button class="btn-place" onclick="chooseSomething(1)">Place</button>
        </div>
        <!-- Stone 2 -->
        <div class="stone-card" data-stone="2" id="stoneCard2">
          <div class="stone-preview white" id="previewStone2">2</div>
          <span class="stock-count" id="countStone2">x5</span>
          <button class="btn-place" onclick="chooseSomething(2)">Place</button>
        </div>
        <!-- Stone 3 -->
        <div class="stone-card" data-stone="3" id="stoneCard3">
          <div class="stone-preview white" id="previewStone3">3</div>
          <span class="stock-count" id="countStone3">x5</span>
          <button class="btn-place" onclick="chooseSomething(3)">Place</button>
        </div>
        <!-- Stone 4 -->
        <div class="stone-card locked" data-stone="4" id="stoneCard4">
          <span class="lock-badge" id="lockBadge4">Move 2+</span>
          <div class="stone-preview white" id="previewStone4">4</div>
          <span class="stock-count" id="countStone4">x5</span>
          <button class="btn-place" onclick="chooseSomething(4)">Place</button>
        </div>
        <!-- Stone 5 -->
        <div class="stone-card locked" data-stone="5" id="stoneCard5">
          <span class="lock-badge" id="lockBadge5">Move 2+</span>
          <div class="stone-preview white" id="previewStone5">5</div>
          <span class="stock-count" id="countStone5">x5</span>
          <button class="btn-place" onclick="chooseSomething(5)">Place</button>
        </div>
      </div>
    </div>

    <!-- Non-Blocking Victory Celebration Banner -->
    <div class="victory-banner none" id="victoryBanner">
      <!-- Full Victory Details Mode -->
      <div class="victory-content" id="victoryContent">
        <div class="victory-main-info">
          <div class="victory-trophy-badge" id="victoryTrophyBadge">🏆</div>
          <div class="victory-text-group">
            <div class="victory-title-row">
              <h2 class="victory-title" id="victoryTitle">Player 1 (White) Wins!</h2>
              <span class="victory-target-badge">Sum: 16</span>
            </div>
            <div class="victory-detail-row">
              <span class="victory-line-desc" id="victoryLineDesc">Winning Line:</span>
              <span class="victory-formula" id="victoryFormula">Net Line Sum = 16</span>
            </div>
          </div>
        </div>
        <div class="victory-actions">
          <button class="btn-inspect" id="btnToggleInspect" title="Minimize banner to fully inspect the board">
            <span id="inspectIcon">👁️</span> <span id="inspectLabel">Inspect Board</span>
          </button>
          <button class="btn-play-again" id="btnPlayAgain">
            🔄 <span>Play Again</span>
          </button>
        </div>
      </div>

      <!-- Minimized Mode for unobstructed inspection -->
      <div class="victory-minimized none" id="victoryMinimized">
        <div class="mini-status">
          <span class="mini-trophy">🏆</span>
          <span class="mini-winner" id="miniWinnerText">Player 1 Wins!</span>
          <span class="mini-formula" id="miniFormula">Sum: 16</span>
        </div>
        <div class="mini-actions">
          <button class="btn-inspect-mini" id="btnExpandBanner" title="Show victory details">
            📋 <span>Show Details</span>
          </button>
          <button class="btn-play-again-mini" id="btnPlayAgainMini">
            🔄 <span>Play Again</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- 10-Second Countdown Modal -->
  <div class="modal-overlay none" id="countdownModal">
    <div class="modal-card">
      <h2>Match Starting!</h2>
      <p>Both players are ready. Prepare your strategy.</p>
      <div class="countdown-number" id="countdownText">10</div>
    </div>
  </div>

  <!-- How to Play Modal -->
  <div class="modal-overlay none" id="rulesModal">
    <div class="modal-card" style="max-width: 500px;">
      <h2>How to Play "Make It 16"</h2>
      <div class="rule-list">
        <div class="rule-item">
          <span class="rule-icon">🎯</span>
          <span><strong>Objective:</strong> Be the first player to achieve a net sum of <strong>exactly 16</strong> along any row, column, or diagonal line.</span>
        </div>
        <div class="rule-item">
          <span class="rule-icon">⚖️</span>
          <span><strong>Tug-of-War Scoring:</strong> In each line, your stones <strong>add</strong> points, while opponent stones <strong>subtract</strong> points!</span>
        </div>
        <div class="rule-item">
          <span class="rule-icon">🔢</span>
          <span><strong>Stone Pool:</strong> Each player has 25 stones (5 of each number: 1, 2, 3, 4, 5). Use your high and low numbers wisely!</span>
        </div>
        <div class="rule-item">
          <span class="rule-icon">🔒</span>
          <span><strong>Opening Balance:</strong> Stones 4 and 5 are locked on Move 1, and unlock from Move 2 onwards.</span>
        </div>
      </div>
      <button class="btn-primary" id="btnCloseRules">Got It</button>
    </div>
  </div>

  <script>
    // Initial server state injected via EJS
    let board_state = <%-JSON.stringify(state) %>;
    let global_player = <%-JSON.stringify(global_player) %>;

    // Client variables
    let listenersEnabled = true;
    let selectedCellId = null;
    let isMuted = localStorage.getItem('make16_muted') === 'true';
    const GRID_SIZE = 15;

    // Hoshi (Star Point) Coordinates in 15x15 Gomoku (0-indexed: 3, 7, 11)
    const HOSHI_POINTS = new Set([
      3 * 15 + 3,  3 * 15 + 7,  3 * 15 + 11,
      7 * 15 + 3,  7 * 15 + 7,  7 * 15 + 11,
      11 * 15 + 3, 11 * 15 + 7, 11 * 15 + 11
    ]);

    // Ensure session userid
    function getUserId() {
      let id = sessionStorage.getItem('userid');
      if (!id) {
        const array = new Uint8Array(16);
        crypto.getRandomValues(array);
        id = Array.from(array, b => b.toString(16).padStart(2, '0')).join('');
        sessionStorage.setItem('userid', id);
      }
      return id;
    }
    const myUserId = getUserId();

    // Sound handling
    function playStoneSound() {
      if (isMuted) return;
      const sound = document.getElementById('clickSound');
      if (sound) {
        sound.currentTime = 0;
        sound.play().catch(() => {});
      }
    }

    function updateMuteButtonUI() {
      const btn = document.getElementById('btnMute');
      if (isMuted) {
        btn.innerHTML = '🔇 <span>Muted</span>';
      } else {
        btn.innerHTML = '🔊 <span>Sound</span>';
      }
    }

    // Build the 15x15 board
    function initBoard() {
      const board = document.getElementById('board');
      board.innerHTML = '';

      for (let i = 0; i < board_state.state.length; i++) {
        const cell = document.createElement('div');
        cell.classList.add('cell');
        cell.dataset.id = i;

        if (HOSHI_POINTS.has(i)) {
          cell.classList.add('star-point');
        }

        cell.addEventListener('click', () => {
          if (!listenersEnabled) return;
          if (cell.querySelector('.stone')) return; // already has stone

          // If not our turn, don't allow selecting
          const isMyTurn = (board_state.whos_turn === myUserId);
          if (!board_state.has_start || !isMyTurn) return;

          selectedCellId = i;
          document.querySelectorAll('.cell.selected').forEach(c => c.classList.remove('selected'));
          cell.classList.add('selected');
        });

        // Place existing stone if any
        const val = board_state.state[i];
        if (val && val !== 0) {
          const type = val[0]; // 'w' or 'b'
          const num = val.substring(1);
          const stone = document.createElement('div');
          stone.classList.add('stone', type === 'b' ? 'black' : 'white');
          stone.textContent = num;
          cell.appendChild(stone);
        }

        board.appendChild(cell);
      }

      if (board_state.winner && board_state.winningCells) {
        highlightWinningCells(board_state.winningCells);
      }
    }

    function highlightWinningCells(cells) {
      document.querySelectorAll('.cell.winning-cell').forEach(c => c.classList.remove('winning-cell'));
      if (cells && Array.isArray(cells)) {
        cells.forEach(idx => {
          const c = document.querySelector(`.cell[data-id="${idx}"]`);
          if (c) c.classList.add('winning-cell');
        });
      }
    }

    function showVictoryUI(winner, winningCells, winningDetails) {
      listenersEnabled = false;
      highlightWinningCells(winningCells);

      // Hide active tray, reveal non-blocking victory banner
      const actionTray = document.getElementById('actionTray');
      if (actionTray) actionTray.classList.add('none');

      const banner = document.getElementById('victoryBanner');
      const content = document.getElementById('victoryContent');
      const minimized = document.getElementById('victoryMinimized');
      const title = document.getElementById('victoryTitle');
      const lineDesc = document.getElementById('victoryLineDesc');
      const formula = document.getElementById('victoryFormula');
      const miniWinner = document.getElementById('miniWinnerText');
      const miniFormula = document.getElementById('miniFormula');
      const statusPillText = document.getElementById('matchStatusText');
      const statusDot = document.getElementById('statusDot');

      const isWhite = (winner === 'white');
      const winnerName = isWhite ? 'Player 1 (White)' : 'Player 2 (Black)';

      if (title) title.textContent = `${winnerName} Wins!`;
      if (miniWinner) miniWinner.textContent = `${winnerName} Wins!`;

      if (winningDetails) {
        if (lineDesc) lineDesc.textContent = `${winningDetails.lineLabel || 'Winning Line'}:`;
        if (formula) formula.textContent = winningDetails.formula || 'Net Line Sum = 16';
        if (miniFormula) miniFormula.textContent = winningDetails.formula || 'Sum: 16';
      } else {
        if (lineDesc) lineDesc.textContent = 'Winning Line:';
        if (formula) formula.textContent = 'Net Line Sum = 16';
        if (miniFormula) miniFormula.textContent = 'Sum: 16';
      }

      if (statusPillText) {
        statusPillText.textContent = `🏆 ${winnerName} Wins!`;
      }
      if (statusDot) {
        statusDot.classList.add('active-turn');
      }

      if (banner) {
        banner.classList.remove('none');
        if (!banner.classList.contains('is-minimized')) {
          if (content) content.classList.remove('none');
          if (minimized) minimized.classList.add('none');
        } else {
          if (content) content.classList.add('none');
          if (minimized) minimized.classList.remove('none');
        }
      }
    }

    function hideVictoryUI() {
      const banner = document.getElementById('victoryBanner');
      if (banner) {
        banner.classList.add('none');
        banner.classList.remove('is-minimized');
        const content = document.getElementById('victoryContent');
        const minimized = document.getElementById('victoryMinimized');
        if (content) content.classList.remove('none');
        if (minimized) minimized.classList.add('none');
      }
      document.querySelectorAll('.cell.winning-cell').forEach(c => c.classList.remove('winning-cell'));
    }

    function updateCellStone(cellIndex, colorType, value) {
      const targetCell = document.querySelector(`.cell[data-id="${cellIndex}"]`);
      if (!targetCell) return;

      const existing = targetCell.querySelector('.stone');
      if (existing) targetCell.removeChild(existing);

      const stone = document.createElement('div');
      stone.classList.add('stone', colorType === 1 ? 'black' : 'white');
      stone.textContent = value;
      targetCell.appendChild(stone);
      targetCell.classList.remove('selected');
    }

    // Update entire UI according to current room status
    function refreshUI() {
      const cardP1 = document.getElementById('cardPlayer1');
      const cardP2 = document.getElementById('cardPlayer2');
      const btnJoinP1 = document.getElementById('btnJoinPlayer1');
      const btnJoinP2 = document.getElementById('btnJoinPlayer2');
      const statusP1 = document.getElementById('statusPlayer1');
      const statusP2 = document.getElementById('statusPlayer2');
      const roleBanner = document.getElementById('roleBanner');
      const statusPillText = document.getElementById('matchStatusText');
      const statusDot = document.getElementById('statusDot');
      const actionTray = document.getElementById('actionTray');

      // Player 1 state
      if (global_player.player1) {
        statusP1.textContent = 'Ready';
        statusP1.classList.add('ready');
        btnJoinP1.style.display = 'none';
        if (global_player.player1 === myUserId) {
          cardP1.classList.add('is-you');
        } else {
          cardP1.classList.remove('is-you');
        }
      } else {
        statusP1.textContent = 'Vacant';
        statusP1.classList.remove('ready');
        btnJoinP1.style.display = (global_player.player2 === myUserId) ? 'none' : 'inline-block';
        cardP1.classList.remove('is-you');
      }

      // Player 2 state
      if (global_player.player2) {
        statusP2.textContent = 'Ready';
        statusP2.classList.add('ready');
        btnJoinP2.style.display = 'none';
        if (global_player.player2 === myUserId) {
          cardP2.classList.add('is-you');
        } else {
          cardP2.classList.remove('is-you');
        }
      } else {
        statusP2.textContent = 'Vacant';
        statusP2.classList.remove('ready');
        btnJoinP2.style.display = (global_player.player1 === myUserId) ? 'none' : 'inline-block';
        cardP2.classList.remove('is-you');
      }

      // Viewer role
      if (myUserId === global_player.player1) {
        roleBanner.textContent = '⚪ You are playing as Player 1 (White)';
        roleBanner.className = 'role-banner role-player';
      } else if (myUserId === global_player.player2) {
        roleBanner.textContent = '⚫ You are playing as Player 2 (Black)';
        roleBanner.className = 'role-banner role-player';
      } else {
        roleBanner.textContent = '👀 You are Spectating (Live Room)';
        roleBanner.className = 'role-banner role-spectator';
      }

      // Active turn & match status
      cardP1.classList.remove('active-turn');
      cardP2.classList.remove('active-turn');
      statusDot.classList.remove('active-turn');

      // Check if match already has a winner
      if (board_state.winner) {
        actionTray.classList.add('none');
        showVictoryUI(board_state.winner, board_state.winningCells, board_state.winningDetails);
        return;
      }

      if (!board_state.has_start) {
        statusPillText.textContent = 'Waiting for Players...';
        actionTray.classList.add('none');
      } else {
        const isWhiteTurn = (board_state.whos_turn === global_player.player1);
        statusDot.classList.add('active-turn');

        if (isWhiteTurn) {
          statusPillText.textContent = "⚪ White's Turn";
          cardP1.classList.add('active-turn');
        } else {
          statusPillText.textContent = "⚫ Black's Turn";
          cardP2.classList.add('active-turn');
        }

        // Show tray only to active player
        const isMyTurn = (board_state.whos_turn === myUserId);
        const amIPlayer = (myUserId === global_player.player1 || myUserId === global_player.player2);

        if (amIPlayer) {
          actionTray.classList.remove('none');
          updateInventoryUI();
          if (isMyTurn) {
            document.getElementById('trayHintText').textContent = 'Your turn! Select a cell, then place a stone:';
          } else {
            document.getElementById('trayHintText').textContent = "Opponent's turn. Planning your next move...";
          }
        } else {
          actionTray.classList.add('none');
        }
      }
    }

    // Update bottom inventory stone counts and lock state
    function updateInventoryUI() {
      const amIWhite = (myUserId === global_player.player1);
      const stones = amIWhite ? board_state.player1_stone : board_state.player2_stone;
      if (!stones) return;

      const isMyTurn = (board_state.whos_turn === myUserId);
      const totalStonesPlaced = board_state.state.filter(c => c !== 0).length;
      const isMoveOne = (totalStonesPlaced === 0);

      const colorClass = amIWhite ? 'white' : 'black';

      for (let i = 1; i <= 5; i++) {
        const card = document.getElementById(`stoneCard${i}`);
        const preview = document.getElementById(`previewStone${i}`);
        const countSpan = document.getElementById(`countStone${i}`);
        const placeBtn = card.querySelector('.btn-place');

        // Color preview
        preview.className = `stone-preview ${colorClass}`;

        const remaining = stones[i - 1];
        countSpan.textContent = `x${remaining}`;

        // Disable if 0 stock
        if (remaining <= 0) {
          card.classList.add('disabled');
          placeBtn.disabled = true;
        } else {
          card.classList.remove('disabled');
          placeBtn.disabled = !isMyTurn;
        }

        // Opening rule: stones 4 and 5 locked on move 1
        if (i >= 4) {
          if (isMoveOne) {
            card.classList.add('locked');
            placeBtn.disabled = true;
          } else {
            card.classList.remove('locked');
            if (remaining > 0 && isMyTurn) {
              placeBtn.disabled = false;
            }
          }
        }
      }
    }

    // Stone placement trigger
    function chooseSomething(stoneValue) {
      if (!listenersEnabled) return;
      if (!board_state.has_start) return;
      if (board_state.whos_turn !== myUserId) return;

      if (selectedCellId === null) {
        alert('Please click an empty cell on the board first!');
        return;
      }
      if (board_state.state[selectedCellId] !== 0) {
        alert('This cell is already occupied.');
        return;
      }

      // Check stock
      const amIWhite = (myUserId === global_player.player1);
      const stones = amIWhite ? board_state.player1_stone : board_state.player2_stone;
      if (stones[stoneValue - 1] <= 0) {
        return;
      }

      // Emit move
      const payload = {
        whoami: myUserId,
        move: stoneValue,
        cell: selectedCellId
      };
      socket.emit('my_turn', payload);
      selectedCellId = null;
    }

    // Socket.IO Setup
    const socket = io();

    // Broadcast room status (spectators count & sync)
    socket.on('room_status', (data) => {
      global_player = data.global;
      board_state = data.information;
      document.getElementById('spectatorCount').textContent = data.spectators || 0;
      refreshUI();
    });

    socket.on('spectator_count', (count) => {
      document.getElementById('spectatorCount').textContent = count || 0;
    });

    socket.on('broadcast_player', (data) => {
      global_player = data.global;
      refreshUI();
    });

    socket.on('game_countdown', (info) => {
      board_state = info;
      listenersEnabled = false;
      const modal = document.getElementById('countdownModal');
      const countdownText = document.getElementById('countdownText');
      modal.classList.remove('none');

      let count = 10;
      countdownText.textContent = count;
      const interval = setInterval(() => {
        count--;
        if (count > 0) {
          countdownText.textContent = count;
        } else {
          clearInterval(interval);
          modal.classList.add('none');
          listenersEnabled = true;

          if (myUserId === global_player.player1 || myUserId === global_player.player2) {
            socket.emit('game_start', myUserId);
          }
        }
      }, 1000);

      refreshUI();
    });

    socket.on('update_move', (info) => {
      board_state = info.master;
      updateCellStone(info.update.cell, info.update.type, info.update.value);
      playStoneSound();

      // Check winner
      if (info.winner) {
        showVictoryUI(info.winner, info.winningCells, info.winningDetails);
      }

      refreshUI();
    });

    socket.on('game_restarted', (data) => {
      board_state = data.information;
      global_player = data.global;
      listenersEnabled = true;
      selectedCellId = null;

      hideVictoryUI();
      document.getElementById('countdownModal').classList.add('none');

      initBoard();
      refreshUI();
    });

    // DOM Ready Event Handlers
    $(document).ready(function () {
      updateMuteButtonUI();
      initBoard();
      refreshUI();

      // Join buttons
      $('#btnJoinPlayer1').on('click', function () {
        if (!listenersEnabled) return;
        socket.emit('join_player_one', myUserId);
      });

      $('#btnJoinPlayer2').on('click', function () {
        if (!listenersEnabled) return;
        socket.emit('join_player_two', myUserId);
      });

      // Inspect board toggle
      $('#btnToggleInspect').on('click', function () {
        $('#victoryContent').addClass('none');
        $('#victoryMinimized').removeClass('none');
        $('#victoryBanner').addClass('is-minimized');
      });

      $('#btnExpandBanner').on('click', function () {
        $('#victoryMinimized').addClass('none');
        $('#victoryContent').removeClass('none');
        $('#victoryBanner').removeClass('is-minimized');
      });

      // Play Again & Reset
      $('#btnPlayAgain, #btnPlayAgainMini, #btnRestart').on('click', function () {
        socket.emit('restart', null);
      });

      // Rules modal
      $('#btnRules').on('click', function () {
        $('#rulesModal').removeClass('none');
      });
      $('#btnCloseRules').on('click', function () {
        $('#rulesModal').addClass('none');
      });

      // Mute toggle
      $('#btnMute').on('click', function () {
        isMuted = !isMuted;
        localStorage.setItem('make16_muted', isMuted);
        updateMuteButtonUI();
      });
    });
  </script>
